# Configurable sleep delay in seconds between calls (default is 2 seconds)
# Can be overridden by passing an argument or setting DELAY_SECONDS env var.
DELAY_SECONDS=${1:-${DELAY_SECONDS:-2}}

# Function to execute the individual download script for a given TTBID
download_ttbid() {
  local ttbid=$1
  echo "=========================================================="
  echo "Bulk Downloader: Commencing download for TTBID $ttbid"
  echo "=========================================================="
  
  # Call the individual download script
  "$SCRIPT_DIR/download-ttbid.zsh" "$ttbid"
}

echo "Starting bulk download of ${#TTBIDS[@]} TTBIDs sequentially..."
echo "Configured loop delay: $DELAY_SECONDS second(s)"
echo ""

# Loop through all defined TTBIDs sequentially
for ttbid in "${TTBIDS[@]}"; do
  # Run download function
  download_ttbid "$ttbid"
  
  echo "Finished processing TTBID $ttbid."
  echo "Sleeping for $DELAY_SECONDS second(s) before next item..."
  echo ""
  sleep "$DELAY_SECONDS"
done

echo "Bulk download complete. All TTBIDs processed successfully."
